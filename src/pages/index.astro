---
import Layout from "../layouts/main.astro";
import JadwalSholat from "../components/JadwalSholat.astro";
import VideoCard from "../components/VideoCard.astro";
import { getPosts, getSiteSettings, getLectures, getMosques, getScholars, getVideoLectures, getSponsors } from "../utils/sanity";
import type { Lecture } from "../utils/sanity";
import { getYoutubeVideos } from "../utils/youtube";
import { urlFor } from "../utils/image";

const posts = await getPosts();
const lectureList = await getLectures();
const siteSettings = await getSiteSettings();
const mosques = await getMosques();
const scholars = await getScholars();
const videoLectures = await getVideoLectures();
const sponsors = await getSponsors();
const ytVideos = await getYoutubeVideos();
const featuredPodcast = ytVideos.find((v) => v.label === "Podcast") ?? ytVideos[0] ?? null;

const now = new Date();
const nearestLectures = lectureList.filter((k) => new Date(k.date) >= now).slice(0, 6);

const getLocationName = (lecture: Lecture) =>
  typeof lecture.location === "string" ? lecture.location : (lecture.location?.name ?? "-");
---

<Layout title={siteSettings?.siteTitle || "TablighMu Sidoarjo"}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <!-- Hero Bento Grid -->
    <section class="mb-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {featuredPodcast && (
            <a
              href="/media"
              class="group relative block overflow-hidden rounded-[2.5rem] bg-white/5 backdrop-blur-xl border border-white/10 lg:col-span-2 aspect-video lg:aspect-auto lg:min-h-[320px] transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_60px_rgba(139,92,246,0.2)]"
            >
              <img
                src={`https://img.youtube.com/vi/${featuredPodcast.id}/maxresdefault.jpg`}
                alt={featuredPodcast.title}
                loading="eager" decoding="async"
                class="w-full h-auto aspect-video object-cover lg:absolute lg:inset-0 lg:h-full transition-transform duration-700 group-hover:scale-105"
              />
              <!-- Dark vignette overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/30 to-transparent" aria-hidden="true"></div>
              {featuredPodcast.label && (
                <span class="absolute top-5 left-5 px-4 py-1.5 text-xs font-semibold text-pink-200 bg-pink-500/20 border border-pink-500/30 rounded-full backdrop-blur-xl">
                  {featuredPodcast.label}
                </span>
              )}
              <!-- Frosted glass play button dead center -->
              <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                <span class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-white/10 backdrop-blur-xl border border-white/25 flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:shadow-[0_0_50px_rgba(255,255,255,0.35)]">
                  <svg class="w-7 h-7 md:w-8 md:h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </div>
              <div class="absolute bottom-0 inset-x-0 p-6 md:p-8">
                <p class="text-white/60 text-xs md:text-sm font-semibold uppercase tracking-widest mb-2">Tonton Podcast Terbaru</p>
                <h2 class="text-xl md:text-2xl font-bold text-white leading-snug line-clamp-2">
                  {featuredPodcast.title}
                </h2>
              </div>
            </a>
          )}
          {/* Cell 2: KHGT Prayer Schedule */}
          <div class="lg:col-span-1 min-h-[300px]">
            <JadwalSholat />
          </div>
      </div>
    </section>

    <!-- Majelis Ilmu Terdekat -->
    {nearestLectures.length > 0 && (
      <section class="mt-16 mb-24">
        <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between mb-10">
          <h2 class="text-2xl md:text-3xl font-bold text-white flex items-center gap-3">
            <svg class="w-6 h-6 text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Majelis Ilmu Terdekat
          </h2>
          <a href="/pengajian" class="inline-flex items-center gap-2 text-white/60 hover:text-white transition-colors font-medium flex-shrink-0">
            Lihat Jadwal
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <div class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
          {nearestLectures.map((lecture) => (
            <article class="group relative overflow-hidden rounded-[2.5rem] bg-white/5 backdrop-blur-xl border border-white/10 transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_40px_rgba(59,130,246,0.15)] hover:-translate-y-1 active:scale-[0.98]">
              {lecture.coverImage && (
                <div class="aspect-[16/10] overflow-hidden relative">
                  <img
                    src={urlFor(lecture.coverImage).width(800).height(500).fit("crop").url()}
                    alt={lecture.coverImage.alt || lecture.title}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy" decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
                  <!-- Iridescent image overlay on hover -->
                  <span class="absolute inset-0 bg-gradient-to-br from-blue-500/10 via-purple-500/5 to-pink-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
                </div>
              )}
              <!-- Iridescent glow border on hover -->
              <span class="absolute inset-0 rounded-[2.5rem] border border-transparent group-hover:border-blue-500/20 group-hover:border-b-purple-500/20 group-hover:border-r-pink-500/20 transition-all duration-500 pointer-events-none"></span>
              <div class="p-6 md:p-8 relative z-10">
                <div class="flex flex-wrap items-center gap-2 mb-4">
                  <span class="px-3 py-1 text-xs font-medium text-blue-300 bg-blue-500/10 border border-blue-500/20 rounded-full backdrop-blur-sm inline-block">
                    Pengajian Mendatang
                  </span>
                  {lecture.muslimahOnly && (
                    <span class="px-3 py-1 text-xs font-medium text-pink-200/90 bg-gradient-to-r from-pink-500/15 to-purple-500/15 border border-pink-300/20 rounded-full backdrop-blur-sm inline-block">
                      Khusus Muslimah
                    </span>
                  )}
                </div>
                <h3 class="text-xl md:text-2xl font-bold text-white leading-tight mb-4">
                  {lecture.title}
                </h3>
                <dl class="space-y-3 text-white/70 text-sm">
                  <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-white/40 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <div>
                      <div class="text-white/40 text-xs uppercase tracking-wider">Tanggal</div>
                      <div class="font-medium">{new Date(lecture.date).toLocaleDateString("id-ID", { weekday: "long", year: "numeric", month: "long", day: "numeric" })}</div>
                    </div>
                  </div>
                  <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-white/40 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <div>
                      <div class="text-white/40 text-xs uppercase tracking-wider">Waktu</div>
                      <div class="font-medium">{lecture.time}</div>
                    </div>
                  </div>
                  <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-white/40 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    </svg>
                    <div>
                      <div class="text-white/40 text-xs uppercase tracking-wider">Lokasi</div>
                      <div class="font-medium">{getLocationName(lecture)}</div>
                    </div>
                  </div>
                </dl>
                {lecture.muslimahOnly && (
                  <div class="mt-5 flex items-start gap-3 p-4 rounded-2xl bg-white/5 backdrop-blur-xl border border-pink-300/15 bg-gradient-to-br from-pink-500/10 via-purple-500/5 to-transparent">
                    <p class="text-sm leading-relaxed text-pink-100/70">
                      Acara khusus muslimah. Mari hadir dengan busana syar'i dan menghindari tabarruj.
                    </p>
                  </div>
                )}
                <a href={`/pengajian/${lecture.slug.current}`} class="mt-6 block w-full text-center px-6 py-3 rounded-xl bg-white/10 border border-white/10 text-white font-medium transition-all duration-300 hover:bg-white/15 hover:border-white/20">
                  Selengkapnya
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Latest Articles -->
    <section class="mb-24">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-white">Artikel Terbaru</h2>
        <a href="/blog" class="inline-flex items-center gap-2 text-white/60 hover:text-white transition-colors font-medium">
          Lihat Semua
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
      
      {posts.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.slice(0, 6).map((post) => (
            <article class="group relative overflow-hidden rounded-[2.5rem] bg-white/5 backdrop-blur-xl border border-white/10 transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_40px_rgba(255,255,255,0.03)] hover:-translate-y-1 active:scale-[0.98]">
              {post.mainImage && (
                <a href={`/blog/${post.slug.current}`} class="block aspect-[16/10] overflow-hidden relative">
                  <img
                    src={urlFor(post.mainImage).width(800).height(500).fit("crop").url()}
                    alt={post.mainImage.alt || post.title}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy" decoding="async"
                  />
                  <!-- Iridescent image overlay on hover -->
                  <span class="absolute inset-0 bg-gradient-to-br from-blue-500/10 via-purple-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
                </a>
              )}
              <!-- Iridescent glow border on hover -->
              <span class="absolute inset-0 rounded-[2.5rem] border border-transparent group-hover:border-blue-500/20 group-hover:border-b-purple-500/20 group-hover:border-r-pink-500/20 transition-all duration-500 pointer-events-none"></span>
              <div class="p-6 md:p-8 relative z-10">
                <time
                  class="text-white/40 text-sm font-medium mb-3 block"
                  dateTime={post.publishedAt}
                >
                  {new Date(post.publishedAt).toLocaleDateString("id-ID", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <h3 class="text-xl md:text-2xl font-bold text-white leading-tight mb-3 group-hover:text-blue-400 transition-colors duration-300">
                  <a href={`/blog/${post.slug.current}`}>
                    {post.title}
                  </a>
                </h3>
                {post.author && (
                  <div class="flex items-center gap-3 pt-4 border-t border-white/5">
                    {post.author.image && (
                      <img
                        src={urlFor(post.author.image).width(36).height(36).fit("crop").url()}
                        alt={post.author.name}
                        loading="lazy"
                        decoding="async"
                        class="rounded-full border border-white/10"
                      />
                    )}
                    <span class="text-white/60 text-sm">
                      Oleh <span class="font-medium text-white/80">{post.author.name}</span>
                    </span>
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-white/40">Belum ada artikel. Tambahkan di Sanity Studio.</p>
        </div>
      )}
    </section>

    <!-- Direktori Masjid -->
    {mosques.length > 0 && (
      <section class="mb-24">
        <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between mb-10">
          <h2 class="text-2xl md:text-3xl font-bold text-white flex items-center gap-3">
            <svg class="w-6 h-6 text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-4h6v4M9 10h.01M15 10h.01M12 10h.01" />
            </svg>
            Direktori Masjid
          </h2>
          <a href="/masjid" class="inline-flex items-center gap-2 text-white/60 hover:text-white transition-colors font-medium flex-shrink-0">
            Lihat Semua
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {mosques.slice(0, 3).map((mosque) => (
            <a
              href={`/masjid/${mosque.slug.current}`}
              class="group relative overflow-hidden rounded-[2rem] bg-white/5 backdrop-blur-xl border border-white/10 p-6 transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_40px_rgba(59,130,246,0.15)] hover:-translate-y-1 active:scale-[0.98]"
            >
              <span class="absolute inset-0 rounded-[2rem] border border-transparent group-hover:border-blue-500/20 group-hover:border-b-purple-500/20 group-hover:border-r-pink-500/20 transition-all duration-500 pointer-events-none"></span>
              {mosque.image ? (
                <img
                  src={urlFor(mosque.image).width(640).height(360).fit("crop").url()}
                  alt={mosque.image.alt || mosque.name}
                  class="w-full aspect-video object-cover rounded-2xl border border-white/10 mb-4 transition-transform duration-700 group-hover:scale-[1.02]"
                  loading="lazy" decoding="async"
                />
              ) : (
                <div class="w-full aspect-video rounded-2xl bg-gradient-to-br from-blue-500/15 via-purple-500/10 to-pink-500/10 border border-white/10 mb-4 flex items-center justify-center">
                  <svg class="w-10 h-10 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-4h6v4" />
                  </svg>
                </div>
              )}
              <h3 class="text-lg font-bold text-white leading-tight mb-1 group-hover:text-blue-300 transition-colors line-clamp-2">{mosque.name}</h3>
              {mosque.address && (
                <p class="text-white/50 text-sm line-clamp-2">{mosque.address}</p>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Asatidzah / Muballigh -->
    {scholars.length > 0 && (
      <section class="mb-24">
        <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between mb-10">
          <h2 class="text-2xl md:text-3xl font-bold text-white flex items-center gap-3">
            <svg class="w-6 h-6 text-purple-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Asatidzah / Muballigh
          </h2>
          <a href="/muballigh" class="inline-flex items-center gap-2 text-white/60 hover:text-white transition-colors font-medium flex-shrink-0">
            Lihat Semua
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {scholars.slice(0, 3).map((scholar) => (
            <a
              href={`/muballigh/${scholar.slug.current}`}
              class="group relative overflow-hidden rounded-[2rem] bg-white/5 backdrop-blur-xl border border-white/10 p-6 text-center transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_40px_rgba(139,92,246,0.15)] hover:-translate-y-1 active:scale-[0.98]"
            >
              <span class="absolute inset-0 rounded-[2rem] border border-transparent group-hover:border-purple-500/20 group-hover:border-b-pink-500/20 group-hover:border-r-blue-500/20 transition-all duration-500 pointer-events-none"></span>
              {scholar.image ? (
                <img
                  src={urlFor(scholar.image).width(300).height(300).fit("crop").url()}
                  alt={scholar.image.alt || scholar.name}
                  class="w-24 h-24 rounded-full object-cover border border-white/10 mx-auto mb-4 transition-transform duration-500 group-hover:scale-105"
                  loading="lazy" decoding="async"
                />
              ) : (
                <div class="w-24 h-24 rounded-full bg-gradient-to-br from-purple-500/20 via-blue-500/10 to-pink-500/10 border border-white/10 mx-auto mb-4 flex items-center justify-center">
                  <svg class="w-10 h-10 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
              )}
              <h3 class="text-lg font-bold text-white leading-tight mb-1 group-hover:text-purple-300 transition-colors line-clamp-2">{scholar.name}</h3>
              {scholar.bio && (
                <p class="text-white/50 text-sm line-clamp-2">{scholar.bio}</p>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Arsip Kajian & Khutbah -->
    {videoLectures.length > 0 && (
      <section class="mb-24">
        <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between mb-10">
          <h2 class="text-2xl md:text-3xl font-bold text-white flex items-center gap-3">
            <svg class="w-6 h-6 text-red-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Arsip Kajian & Khutbah
          </h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {videoLectures.slice(0, 6).map((video) => (
            <VideoCard video={video} />
          ))}
        </div>
      </section>
    )}

    {/* Section Sponsor */}
    {sponsors.length > 0 && (
      <section class="mb-8">
        <h2 class="text-xl md:text-2xl font-bold text-white text-center">
          Didukung oleh Mitra Kebaikan
        </h2>
        <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12 mt-8">
          {sponsors.map((sponsor) => (
            sponsor.logoUrl ? (
              sponsor.url ? (
                <a
                  href={sponsor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={sponsor.name}
                  title={sponsor.name}
                >
                  <img
                    src={sponsor.logoUrl}
                    alt={sponsor.name}
                    loading="lazy" decoding="async"
                    class="h-10 md:h-12 w-auto object-contain grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-500"
                  />
                </a>
              ) : (
                <img
                  src={sponsor.logoUrl}
                  alt={sponsor.name}
                  title={sponsor.name}
                  loading="lazy" decoding="async"
                  class="h-10 md:h-12 w-auto object-contain grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-500"
                />
              )
            ) : null
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>