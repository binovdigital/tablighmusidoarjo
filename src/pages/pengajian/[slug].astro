---
import Layout from "../../layouts/main.astro";
import { getLectureBySlug, getLectureSlugs } from "../../utils/sanity";
import { urlFor } from "../../utils/image";
import PortableTextRenderer from "../../components/blog/PortableTextRenderer.astro";

export async function getStaticPaths() {
  const slugs = await getLectureSlugs();
  return slugs.map((slug) => ({
    params: { slug: slug.params.slug },
  }));
}

const { slug } = Astro.params;
const lecture = await getLectureBySlug(slug as string);

if (!lecture) {
  return Astro.redirect("/404");
}

// Mendukung data lama (string) maupun relasi baru (object)
const locationName =
  typeof lecture.location === "string" ? lecture.location : (lecture.location?.name ?? "-");
const locationAddress =
  typeof lecture.location === "string" ? null : lecture.location?.address;
const googleMapsUrl =
  typeof lecture.location === "string" ? null : lecture.location?.googleMapsUrl;
const speakerName =
  typeof lecture.speaker === "string" ? lecture.speaker : (lecture.speaker?.name ?? "-");
---

<Layout title={lecture.title}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <header class="mb-12">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-300 text-sm font-medium mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Kajian
      </span>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6">{lecture.title}</h1>

      {lecture.muslimahOnly && (
        <div class="flex items-start gap-3 p-5 rounded-[1.5rem] bg-white/5 backdrop-blur-xl border border-pink-300/15 bg-gradient-to-br from-pink-500/10 via-purple-500/5 to-transparent mb-8">
          <svg class="w-5 h-5 text-pink-200/70 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div>
            <p class="text-sm font-medium text-pink-100/90 tracking-wide mb-1">Khusus Muslimah</p>
            <p class="text-sm leading-relaxed text-pink-100/70">
              Acara khusus muslimah. Mari hadir dengan busana syar'i dan menghindari tabarruj.
            </p>
          </div>
        </div>
      )}
      
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4 mb-8">
        <div class="group flex items-center gap-3 p-4 rounded-2xl bg-white/5 border border-white/10 transition-all duration-300 hover:border-blue-500/20 hover:shadow-[0_0_30px_rgba(59,130,246,0.1)]">
          <div class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <div class="text-white/40 text-xs uppercase tracking-wider">Tanggal</div>
            <div class="font-medium text-white">{new Date(lecture.date).toLocaleDateString("id-ID", { weekday: "long", year: "numeric", month: "long", day: "numeric" })}</div>
          </div>
        </div>
        <div class="group flex items-center gap-3 p-4 rounded-2xl bg-white/5 border border-white/10 transition-all duration-300 hover:border-purple-500/20 hover:shadow-[0_0_30px_rgba(139,92,246,0.1)]">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <div class="text-white/40 text-xs uppercase tracking-wider">Waktu</div>
            <div class="font-medium text-white">{lecture.time}</div>
          </div>
        </div>
        <div class="group flex items-center gap-3 p-4 rounded-2xl bg-white/5 border border-white/10 transition-all duration-300 hover:border-pink-500/20 hover:shadow-[0_0_30px_rgba(236,72,153,0.1)]">
          <div class="w-10 h-10 rounded-xl bg-pink-500/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            </svg>
          </div>
          <div>
            <div class="text-white/40 text-xs uppercase tracking-wider">Lokasi</div>
            <div class="font-medium text-white">{locationName}</div>
            {locationAddress && (
              <div class="text-white/50 text-sm mt-0.5">{locationAddress}</div>
            )}
            {googleMapsUrl && (
              <a
                href={googleMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-pink-200/70 hover:text-pink-100 text-sm mt-1 transition-colors"
              >
                Lihat di Google Maps
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
          </div>
        </div>
        <div class="group flex items-center gap-3 p-4 rounded-2xl bg-white/5 border border-white/10 transition-all duration-300 hover:border-cyan-500/20 hover:shadow-[0_0_30px_rgba(6,182,212,0.1)]">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div>
            <div class="text-white/40 text-xs uppercase tracking-wider">Pemateri</div>
            <div class="font-medium text-white">{speakerName}</div>
          </div>
        </div>
      </div>
    </header>

    {lecture.coverImage && (
      <figure class="mb-12 rounded-[2.5rem] overflow-hidden relative group">
        <img
          src={urlFor(lecture.coverImage).width(1600).url()}
          alt={lecture.coverImage.alt || lecture.title}
          decoding="async"
          class="w-full h-auto"
        />
        <!-- Iridescent overlay on hover -->
        <span class="absolute inset-0 bg-gradient-to-br from-blue-500/10 via-purple-500/5 to-pink-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
        <!-- Iridescent glow border -->
        <span class="absolute inset-0 rounded-[2.5rem] border border-transparent group-hover:border-blue-500/20 group-hover:border-b-purple-500/20 group-hover:border-r-pink-500/20 transition-all duration-500 pointer-events-none"></span>
      </figure>
    )}

    <div class="prose prose-lg max-w-none text-white/80">
      <PortableTextRenderer value={lecture.description} />
    </div>

    <nav class="mt-16 pt-8 border-t border-white/10">
      <a href="/pengajian" class="inline-flex items-center gap-2 text-white/60 hover:text-white transition-colors font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
        </svg>
        Kembali ke Jadwal Kajian
      </a>
    </nav>
  </article>
</Layout>