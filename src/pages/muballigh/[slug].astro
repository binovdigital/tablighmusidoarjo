---
import Layout from "../../layouts/main.astro";
import { getScholarBySlug, getScholarSlugs } from "../../utils/sanity";
import type { Lecture } from "../../utils/sanity";
import { urlFor } from "../../utils/image";

export async function getStaticPaths() {
  const slugs = await getScholarSlugs();
  return slugs.map((slug) => ({
    params: { slug: slug.params.slug },
  }));
}

const { slug } = Astro.params;
const scholar = await getScholarBySlug(slug as string);

if (!scholar) {
  return Astro.redirect("/404");
}

const now = new Date();
const lectures = scholar.lectures ?? [];
const upcomingLectures = lectures.filter((lecture) => new Date(lecture.date) >= now);
const pastLectures = lectures.filter((lecture) => new Date(lecture.date) < now);

const getLocationName = (lecture: Lecture) =>
  typeof lecture.location === "string" ? lecture.location : (lecture.location?.name ?? "-");
---

<Layout title={`${scholar.name} - Muballigh`}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <header class="mb-12">
      <a href="/muballigh" class="inline-flex items-center gap-2 text-white/60 hover:text-white transition-colors font-medium text-sm mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
        </svg>
        Direktori Muballigh
      </a>
      <div class="flex flex-col sm:flex-row items-start gap-6">
        {scholar.image && (
          <img
            src={urlFor(scholar.image).width(320).height(320).fit("crop").url()}
            alt={scholar.image.alt || scholar.name}
            decoding="async"
            class="w-32 h-32 md:w-40 md:h-40 rounded-[1.5rem] object-cover border border-white/10 flex-shrink-0"
          />
        )}
        <div>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight mb-4">{scholar.name}</h1>
          {scholar.bio && (
            <p class="text-white/70 text-lg leading-relaxed max-w-2xl">{scholar.bio}</p>
          )}
          {scholar.contact && (
            <div class="mt-4 inline-flex items-center gap-3 px-4 py-2.5 rounded-2xl bg-white/5 border border-white/10">
              <svg class="w-5 h-5 text-purple-300/80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span class="text-white/80 text-sm font-medium">{scholar.contact}</span>
            </div>
          )}
        </div>
      </div>
    </header>

    {upcomingLectures.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-white mb-6">Kajian Mendatang Bersama Beliau</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {upcomingLectures.map((lecture) => (
            <a
              href={`/pengajian/${lecture.slug.current}`}
              class="group relative overflow-hidden rounded-[1.5rem] bg-white/5 backdrop-blur-xl border border-white/10 p-5 transition-all duration-300 hover:border-white/20 hover:-translate-y-1"
            >
              <span class="absolute inset-0 rounded-[1.5rem] border border-transparent group-hover:border-purple-500/20 transition-all duration-500 pointer-events-none"></span>
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="px-2.5 py-0.5 text-xs font-medium text-blue-300 bg-blue-500/10 border border-blue-500/20 rounded-full">
                  Pengajian Mendatang
                </span>
                {lecture.muslimahOnly && (
                  <span class="px-2.5 py-0.5 text-xs font-medium text-pink-200/90 bg-gradient-to-r from-pink-500/15 to-purple-500/15 border border-pink-300/20 rounded-full">
                    Khusus Muslimah
                  </span>
                )}
              </div>
              <h3 class="font-bold text-white leading-snug mb-2 group-hover:text-purple-300 transition-colors">{lecture.title}</h3>
              <p class="text-white/50 text-sm">
                {new Date(lecture.date).toLocaleDateString("id-ID", { weekday: "long", day: "numeric", month: "long", year: "numeric" })} &bull; {lecture.time} &bull; {getLocationName(lecture)}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}

    {pastLectures.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-white mb-6">Kajian Terdahulu Bersama Beliau</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {pastLectures.slice(0, 6).map((lecture) => (
            <a
              href={`/pengajian/${lecture.slug.current}`}
              class="group relative overflow-hidden rounded-[1.5rem] bg-white/5 backdrop-blur-xl border border-white/10 p-5 transition-all duration-300 hover:border-white/20 hover:-translate-y-1 opacity-70"
            >
              <h3 class="font-bold text-white leading-snug mb-2 group-hover:text-purple-300 transition-colors">{lecture.title}</h3>
              <p class="text-white/50 text-sm">
                {new Date(lecture.date).toLocaleDateString("id-ID", { weekday: "long", day: "numeric", month: "long", year: "numeric" })} &bull; {getLocationName(lecture)}
              </p>
            </a>
          ))}
        </div>
        {pastLectures.length > 6 && (
          <p class="text-white/40 mt-4 text-sm">Dan {pastLectures.length - 6} kajian lainnya...</p>
        )}
      </section>
    )}

    <nav class="mt-16 pt-8 border-t border-white/10">
      <a href="/muballigh" class="inline-flex items-center gap-2 text-white/60 hover:text-white transition-colors font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
        </svg>
        Kembali ke Direktori Muballigh
      </a>
    </nav>
  </article>
</Layout>
