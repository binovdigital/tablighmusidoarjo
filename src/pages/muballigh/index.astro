---
import Layout from "../../layouts/main.astro";
import { getScholars, getExpertises } from "../../utils/sanity";
import { urlFor } from "../../utils/image";

const scholars = await getScholars();
const expertises = await getExpertises();
---

<Layout title="Direktori Muballigh - TablighMu Sidoarjo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <header class="mb-16 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white tracking-tight mb-4">Asatidzah & Muballigh</h1>
      <p class="text-white/60 text-lg max-w-2xl mx-auto">
        Kenali para asatidz dan muballigh yang mengisi kajian dan pengajian di Sidoarjo.
      </p>
    </header>

    {expertises.length > 0 && (
      <section class="mb-16">
        <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight mb-10 text-center">
          Cari Ustadz Terakreditasi TablighMu
        </h2>
        <div class="space-y-10">
          {expertises.map((expertise) => (
            <div>
              <h3 class="text-xl md:text-2xl font-bold text-white leading-tight">
                {expertise.name}
              </h3>
              {expertise.description && (
                <p class="text-sm text-zinc-400 italic mt-1 mb-5 max-w-3xl">
                  {expertise.description}
                </p>
              )}
              {expertise.scholars && expertise.scholars.length > 0 ? (
                <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
                  {expertise.scholars.map((scholar) => (
                    scholar.slug ? (
                      <a
                        href={`/muballigh/${scholar.slug.current}`}
                        class="group relative overflow-hidden rounded-[2rem] bg-white/5 backdrop-blur-xl border border-white/10 p-5 text-center transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_40px_rgba(139,92,246,0.15)] hover:-translate-y-1 active:scale-[0.98]"
                      >
                        {scholar.photoUrl ? (
                          <img
                            src={scholar.photoUrl}
                            alt={scholar.name}
                            loading="lazy"
                            decoding="async"
                            class="w-20 h-20 rounded-full object-cover border border-white/10 mx-auto mb-3 transition-transform duration-500 group-hover:scale-105"
                          />
                        ) : (
                          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-purple-500/20 via-blue-500/10 to-pink-500/10 border border-white/10 mx-auto mb-3 flex items-center justify-center">
                            <svg class="w-8 h-8 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                          </div>
                        )}
                        <p class="text-base font-bold text-white leading-tight mb-1 group-hover:text-purple-300 transition-colors line-clamp-2">
                          {scholar.name}
                        </p>
                        {scholar.instansi && (
                          <p class="text-white/50 text-xs line-clamp-2">{scholar.instansi}</p>
                        )}
                      </a>
                    ) : (
                      <div class="relative overflow-hidden rounded-[2rem] bg-white/5 backdrop-blur-xl border border-white/10 p-5 text-center">
                        {scholar.photoUrl && (
                          <img
                            src={scholar.photoUrl}
                            alt={scholar.name}
                            loading="lazy"
                            decoding="async"
                            class="w-20 h-20 rounded-full object-cover border border-white/10 mx-auto mb-3"
                          />
                        )}
                        <p class="text-base font-bold text-white leading-tight mb-1 line-clamp-2">
                          {scholar.name}
                        </p>
                        {scholar.instansi && (
                          <p class="text-white/50 text-xs line-clamp-2">{scholar.instansi}</p>
                        )}
                      </div>
                    )
                  ))}
                </div>
              ) : (
                <p class="text-white/40 text-sm">Belum ada ustadz terdaftar pada kepakaran ini.</p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {scholars.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {scholars.map((scholar) => (
          <article class="group relative overflow-hidden rounded-[2.5rem] bg-white/5 backdrop-blur-xl border border-white/10 transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_40px_rgba(139,92,246,0.15)] hover:-translate-y-1 active:scale-[0.98] flex flex-col">
            {scholar.image && (
              <a href={`/muballigh/${scholar.slug.current}`} class="block aspect-square overflow-hidden relative flex-shrink-0">
                <img
                  src={urlFor(scholar.image).width(800).height(800).fit("crop").url()}
                  alt={scholar.image.alt || scholar.name}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy" decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
                <!-- Iridescent image overlay on hover -->
                <span class="absolute inset-0 bg-gradient-to-br from-purple-500/10 via-blue-500/5 to-pink-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
              </a>
            )}
            <!-- Iridescent glow border on hover -->
            <span class="absolute inset-0 rounded-[2.5rem] border border-transparent group-hover:border-purple-500/20 group-hover:border-b-pink-500/20 group-hover:border-r-blue-500/20 transition-all duration-500 pointer-events-none"></span>
            <div class="p-6 md:p-8 relative z-10 flex flex-col flex-grow">
              <h2 class="text-xl md:text-2xl font-bold text-white leading-tight mb-3 group-hover:text-purple-300 transition-colors duration-300 line-clamp-2">
                <a href={`/muballigh/${scholar.slug.current}`}>
                  {scholar.name}
                </a>
              </h2>
              {scholar.bio && (
                <p class="text-white/60 text-sm leading-relaxed mb-4 line-clamp-3">{scholar.bio}</p>
              )}
              <div class="mt-auto pt-4">
                <a href={`/muballigh/${scholar.slug.current}`} class="block w-full text-center px-6 py-3 rounded-xl bg-white/10 border border-white/10 text-white font-medium transition-all duration-300 hover:bg-white/15 hover:border-white/20 hover:shadow-[0_0_30px_rgba(255,255,255,0.05)]">
                  Lihat Profil
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-24">
        <svg class="mx-auto h-16 w-16 text-white/20 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <h3 class="text-xl font-semibold text-white/70 mb-2">Belum Ada Data Muballigh</h3>
        <p class="text-white/40">Data muballigh akan muncul di sini setelah ditambahkan di Sanity Studio.</p>
      </div>
    )}
  </div>
</Layout>
