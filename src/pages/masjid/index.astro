---
import Layout from "../../layouts/main.astro";
import { getMosques } from "../../utils/sanity";
import { urlFor } from "../../utils/image";

const mosques = await getMosques();
---

<Layout title="Direktori Masjid - TablighMu Sidoarjo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <header class="mb-16 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white tracking-tight mb-4">Direktori Masjid</h1>
      <p class="text-white/60 text-lg max-w-2xl mx-auto">
        Jelajahi masjid-masjid di Sidoarjo tempat kajian dan pengajian rutin diselenggarakan.
      </p>
    </header>

    {mosques.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {mosques.map((mosque) => (
          <article class="group relative overflow-hidden rounded-[2.5rem] bg-white/5 backdrop-blur-xl border border-white/10 transition-all duration-300 hover:border-white/20 hover:shadow-[0_0_40px_rgba(59,130,246,0.15)] hover:-translate-y-1 active:scale-[0.98] flex flex-col">
            {mosque.image && (
              <a href={`/masjid/${mosque.slug.current}`} class="block aspect-video overflow-hidden relative flex-shrink-0">
                <img
                  src={urlFor(mosque.image).width(960).height(540).fit("crop").url()}
                  alt={mosque.image.alt || mosque.name}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy" decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
                <!-- Iridescent image overlay on hover -->
                <span class="absolute inset-0 bg-gradient-to-br from-blue-500/10 via-purple-500/5 to-pink-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
              </a>
            )}
            <!-- Iridescent glow border on hover -->
            <span class="absolute inset-0 rounded-[2.5rem] border border-transparent group-hover:border-blue-500/20 group-hover:border-b-purple-500/20 group-hover:border-r-pink-500/20 transition-all duration-500 pointer-events-none"></span>
            <div class="p-6 md:p-8 relative z-10 flex flex-col flex-grow">
              <h2 class="text-xl md:text-2xl font-bold text-white leading-tight mb-3 group-hover:text-blue-400 transition-colors duration-300 line-clamp-2">
                <a href={`/masjid/${mosque.slug.current}`}>
                  {mosque.name}
                </a>
              </h2>
              {mosque.address && (
                <p class="flex items-start gap-2 text-white/60 text-sm leading-relaxed mb-4">
                  <svg class="w-4 h-4 text-white/40 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="line-clamp-2">{mosque.address}</span>
                </p>
              )}
              {mosque.facilities && mosque.facilities.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-4">
                  {mosque.facilities.slice(0, 3).map((facility) => (
                    <span class="px-3 py-1 text-xs font-medium text-white/60 bg-white/5 border border-white/10 rounded-full">
                      {facility}
                    </span>
                  ))}
                  {mosque.facilities.length > 3 && (
                    <span class="px-3 py-1 text-xs font-medium text-white/40 bg-white/5 border border-white/10 rounded-full">
                      +{mosque.facilities.length - 3} lainnya
                    </span>
                  )}
                </div>
              )}
              <div class="mt-auto pt-4">
                <a href={`/masjid/${mosque.slug.current}`} class="block w-full text-center px-6 py-3 rounded-xl bg-white/10 border border-white/10 text-white font-medium transition-all duration-300 hover:bg-white/15 hover:border-white/20 hover:shadow-[0_0_30px_rgba(255,255,255,0.05)]">
                  Lihat Detail
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-24">
        <svg class="mx-auto h-16 w-16 text-white/20 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-4h6v4" />
        </svg>
        <h3 class="text-xl font-semibold text-white/70 mb-2">Belum Ada Data Masjid</h3>
        <p class="text-white/40">Data masjid akan muncul di sini setelah ditambahkan di Sanity Studio.</p>
      </div>
    )}
  </div>
</Layout>
