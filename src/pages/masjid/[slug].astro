---
import Layout from "../../layouts/main.astro";
import { getMosqueBySlug, getMosqueSlugs } from "../../utils/sanity";
import type { Lecture } from "../../utils/sanity";
import { urlFor } from "../../utils/image";

export async function getStaticPaths() {
  const slugs = await getMosqueSlugs();
  return slugs.map((slug) => ({
    params: { slug: slug.params.slug },
  }));
}

const { slug } = Astro.params;
const mosque = await getMosqueBySlug(slug as string);

if (!mosque) {
  return Astro.redirect("/404");
}

const now = new Date();
const lectures = mosque.lectures ?? [];
const upcomingLectures = lectures.filter((lecture) => new Date(lecture.date) >= now);
const pastLectures = lectures.filter((lecture) => new Date(lecture.date) < now);

const getSpeakerName = (lecture: Lecture) =>
  typeof lecture.speaker === "string" ? lecture.speaker : (lecture.speaker?.name ?? "-");
---

<Layout title={`${mosque.name} - Direktori Masjid`}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <header class="mb-12">
      <a href="/masjid" class="inline-flex items-center gap-2 text-white/60 hover:text-white transition-colors font-medium text-sm mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
        </svg>
        Direktori Masjid
      </a>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6">{mosque.name}</h1>

      <div class="flex flex-col gap-4 mb-8">
        {mosque.address && (
          <div class="flex items-start gap-3 p-4 rounded-2xl bg-white/5 border border-white/10">
            <div class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <div class="text-white/40 text-xs uppercase tracking-wider">Alamat</div>
              <div class="font-medium text-white leading-relaxed">{mosque.address}</div>
              {mosque.googleMapsUrl && (
                <a
                  href={mosque.googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-blue-300 hover:text-blue-200 text-sm mt-1 transition-colors"
                >
                  Buka di Google Maps
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        )}
        {mosque.facilities && mosque.facilities.length > 0 && (
          <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
            <div class="text-white/40 text-xs uppercase tracking-wider mb-3">Fasilitas</div>
            <div class="flex flex-wrap gap-2">
              {mosque.facilities.map((facility) => (
                <span class="px-3 py-1.5 text-sm font-medium text-white/70 bg-white/5 border border-white/10 rounded-full backdrop-blur-sm">
                  {facility}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    </header>

    {mosque.image && (
      <figure class="mb-12 rounded-[2.5rem] overflow-hidden relative group">
        <img
          src={urlFor(mosque.image).width(1600).url()}
          alt={mosque.image.alt || mosque.name}
          decoding="async"
          class="w-full h-auto"
        />
        <!-- Iridescent overlay on hover -->
        <span class="absolute inset-0 bg-gradient-to-br from-blue-500/10 via-purple-500/5 to-pink-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
        <!-- Iridescent glow border -->
        <span class="absolute inset-0 rounded-[2.5rem] border border-transparent group-hover:border-blue-500/20 group-hover:border-b-purple-500/20 group-hover:border-r-pink-500/20 transition-all duration-500 pointer-events-none"></span>
      </figure>
    )}

    {upcomingLectures.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-white mb-6">Kajian Mendatang di Sini</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {upcomingLectures.map((lecture) => (
            <a
              href={`/pengajian/${lecture.slug.current}`}
              class="group relative overflow-hidden rounded-[1.5rem] bg-white/5 backdrop-blur-xl border border-white/10 p-5 transition-all duration-300 hover:border-white/20 hover:-translate-y-1"
            >
              <span class="absolute inset-0 rounded-[1.5rem] border border-transparent group-hover:border-blue-500/20 transition-all duration-500 pointer-events-none"></span>
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="px-2.5 py-0.5 text-xs font-medium text-blue-300 bg-blue-500/10 border border-blue-500/20 rounded-full">
                  Pengajian Mendatang
                </span>
                {lecture.muslimahOnly && (
                  <span class="px-2.5 py-0.5 text-xs font-medium text-pink-200/90 bg-gradient-to-r from-pink-500/15 to-purple-500/15 border border-pink-300/20 rounded-full">
                    Khusus Muslimah
                  </span>
                )}
              </div>
              <h3 class="font-bold text-white leading-snug mb-2 group-hover:text-blue-300 transition-colors">{lecture.title}</h3>
              <p class="text-white/50 text-sm">
                {new Date(lecture.date).toLocaleDateString("id-ID", { weekday: "long", day: "numeric", month: "long", year: "numeric" })} &bull; {lecture.time} &bull; {getSpeakerName(lecture)}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}

    {pastLectures.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-white mb-6">Kajian Terdahulu di Sini</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {pastLectures.slice(0, 6).map((lecture) => (
            <a
              href={`/pengajian/${lecture.slug.current}`}
              class="group relative overflow-hidden rounded-[1.5rem] bg-white/5 backdrop-blur-xl border border-white/10 p-5 transition-all duration-300 hover:border-white/20 hover:-translate-y-1 opacity-70"
            >
              <h3 class="font-bold text-white leading-snug mb-2 group-hover:text-blue-300 transition-colors">{lecture.title}</h3>
              <p class="text-white/50 text-sm">
                {new Date(lecture.date).toLocaleDateString("id-ID", { weekday: "long", day: "numeric", month: "long", year: "numeric" })} &bull; {getSpeakerName(lecture)}
              </p>
            </a>
          ))}
        </div>
        {pastLectures.length > 6 && (
          <p class="text-white/40 mt-4 text-sm">Dan {pastLectures.length - 6} kajian lainnya...</p>
        )}
      </section>
    )}

    <nav class="mt-16 pt-8 border-t border-white/10">
      <a href="/masjid" class="inline-flex items-center gap-2 text-white/60 hover:text-white transition-colors font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
        </svg>
        Kembali ke Direktori Masjid
      </a>
    </nav>
  </article>
</Layout>
