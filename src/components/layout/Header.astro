---
import { urlFor } from "../../utils/image";
import { getCategories } from "../../utils/sanity";

interface Props {
  siteTitle: string;
  logo?: any;
}
const { siteTitle, logo } = Astro.props;

// Kategori untuk dropdown Artikel (di-fetch saat build)
let categories: Awaited<ReturnType<typeof getCategories>> = [];
try {
  categories = await getCategories();
} catch {
  categories = [];
}
---
<header class="sticky top-0 z-50 w-full border-b border-white/5 bg-zinc-950/60 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 md:h-20">
      <div class="flex items-center">
        {logo ? (
          <a href="/" class="flex items-center" aria-label={siteTitle}>
            <img
              src={urlFor(logo).height(96).fit("max").url()}
              alt={siteTitle}
              loading="eager"
              decoding="async"
              class="h-10 md:h-12 w-auto max-w-[200px] object-contain"
            />
          </a>
        ) : (
          <a href="/" class="text-xl font-bold text-white tracking-tight" aria-label={siteTitle}>
            {siteTitle}
          </a>
        )}
      </div>
      <nav class="hidden md:flex items-center gap-1" aria-label="Navigasi utama">
        <a
          href="/"
          class="group relative flex items-center gap-2 px-4 py-2 rounded-full text-white/70 hover:text-white active:scale-95 transition-all duration-300 font-medium overflow-hidden"
          aria-label="Beranda"
        >
          <span class="relative z-10 flex flex-row items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Beranda
          </span>
          <!-- Iridescent hover overlay -->
          <span class="absolute inset-0 bg-gradient-to-tr from-blue-500/10 via-purple-500/10 to-pink-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
          <!-- Glowing border on hover -->
          <span class="absolute inset-0 border border-transparent group-hover:border-white/10 transition-colors duration-500 pointer-events-none"></span>
        </a>
        <div class="group relative">
          <a
            href="/blog"
            class="relative flex items-center gap-2 px-4 py-2 rounded-full text-white/70 hover:text-white active:scale-95 transition-all duration-300 font-medium overflow-hidden"
            aria-label="Artikel"
            aria-haspopup="true"
          >
            <span class="relative z-10 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2m-2 9h-1m2 2v-4m0 0l3-3m-3 3l-3-3" />
              </svg>
              Artikel
              <svg class="w-3.5 h-3.5 opacity-60 transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" />
              </svg>
            </span>
            <span class="absolute inset-0 bg-gradient-to-tr from-blue-500/10 via-purple-500/10 to-pink-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
            <span class="absolute inset-0 border border-transparent group-hover:border-white/10 transition-colors duration-500 pointer-events-none rounded-full"></span>
          </a>
          <!-- Dropdown kategori -->
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-300">
            <div class="min-w-56 overflow-hidden rounded-2xl bg-zinc-950/80 backdrop-blur-md border border-white/10 shadow-[0_20px_60px_rgba(0,0,0,0.5)] p-2">
              <a
                href="/blog"
                class="block px-4 py-2.5 rounded-xl text-sm font-semibold text-white hover:bg-white/10 transition-colors"
              >
                Semua Artikel
              </a>
              {categories.length > 0 && (
                <div class="my-1 h-px bg-white/10" aria-hidden="true"></div>
              )}
              {categories.map((category) => (
                <a
                  href={`/artikel/kategori/${category.slug.current}`}
                  class="block px-4 py-2.5 rounded-xl text-sm text-white/70 hover:text-white hover:bg-white/10 transition-colors"
                >
                  {category.title}
                </a>
              ))}
            </div>
          </div>
        </div>
        <a
          href="/pengajian"
          class="group relative flex items-center gap-2 px-4 py-2 rounded-full text-white/70 hover:text-white active:scale-95 transition-all duration-300 font-medium overflow-hidden"
          aria-label="Jadwal Kajian"
        >
          <span class="relative z-10 flex flex-row items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Kajian
          </span>
          <span class="absolute inset-0 bg-gradient-to-tr from-blue-500/10 via-purple-500/10 to-pink-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
          <span class="absolute inset-0 border border-transparent group-hover:border-white/10 transition-colors duration-500 pointer-events-none"></span>
        </a>
        <a
          href="/masjid"
          class="group relative flex items-center gap-2 px-4 py-2 rounded-full text-white/70 hover:text-white active:scale-95 transition-all duration-300 font-medium overflow-hidden"
          aria-label="Direktori Masjid"
        >
          <span class="relative z-10 flex flex-row items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-4h6v4M9 10h.01M15 10h.01M12 10h.01" />
            </svg>
            Masjid
          </span>
          <span class="absolute inset-0 bg-gradient-to-tr from-blue-500/10 via-purple-500/10 to-pink-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
          <span class="absolute inset-0 border border-transparent group-hover:border-white/10 transition-colors duration-500 pointer-events-none"></span>
        </a>
        <a
          href="/muballigh"
          class="group relative flex items-center gap-2 px-4 py-2 rounded-full text-white/70 hover:text-white active:scale-95 transition-all duration-300 font-medium overflow-hidden"
          aria-label="Direktori Muballigh"
        >
          <span class="relative z-10 flex flex-row items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            Muballigh
          </span>
          <span class="absolute inset-0 bg-gradient-to-tr from-blue-500/10 via-purple-500/10 to-pink-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
          <span class="absolute inset-0 border border-transparent group-hover:border-white/10 transition-colors duration-500 pointer-events-none"></span>
        </a>
        <a
          href="/media"
          class="group relative flex items-center gap-2 px-4 py-2 rounded-full text-white/70 hover:text-white active:scale-95 transition-all duration-300 font-medium overflow-hidden"
          aria-label="Galeri Media"
        >
          <span class="relative z-10 flex flex-row items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Media
          </span>
          <span class="absolute inset-0 bg-gradient-to-tr from-blue-500/10 via-purple-500/10 to-pink-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
          <span class="absolute inset-0 border border-transparent group-hover:border-white/10 transition-colors duration-500 pointer-events-none"></span>
        </a>
      </nav>
      <!-- Burger button (mobile only) -->
      <button
        id="menu-open-btn"
        type="button"
        aria-label="Buka menu navigasi"
        aria-controls="mobile-sidebar"
        class="flex md:hidden items-center justify-center w-11 h-11 rounded-full text-white/80 hover:text-white hover:bg-white/10 active:scale-95 transition-all duration-300"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Backdrop -->
<div
  id="mobile-backdrop"
  class="md:hidden fixed inset-0 z-[90] bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<!-- Mobile sidebar -->
<aside
  id="mobile-sidebar"
  aria-label="Menu navigasi seluler"
  class="md:hidden fixed inset-y-0 right-0 z-[100] w-64 bg-zinc-950/95 backdrop-blur-2xl border-l border-white/10 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col p-6 overflow-y-auto"
>
  <div class="flex items-center justify-between mb-8">
    <span class="text-lg font-bold text-white tracking-tight">Menu</span>
    <button
      id="menu-close-btn"
      type="button"
      aria-label="Tutup menu navigasi"
      class="flex items-center justify-center w-10 h-10 rounded-full text-white/70 hover:text-white hover:bg-white/10 active:scale-95 transition-all duration-300"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <nav class="flex flex-col gap-6 text-lg" aria-label="Navigasi seluler">
    <a href="/" class="text-white/70 hover:text-white font-medium transition-colors">Beranda</a>
    <details class="group">
      <summary class="flex items-center justify-between text-white/70 hover:text-white font-medium transition-colors cursor-pointer list-none">
        <span>Artikel</span>
        <svg class="w-4 h-4 opacity-60 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="mt-3 ml-1 flex flex-col gap-3 border-l border-white/10 pl-4">
        <a href="/blog" class="text-base font-semibold text-white hover:text-white transition-colors">Semua Artikel</a>
        {categories.map((category) => (
          <a
            href={`/artikel/kategori/${category.slug.current}`}
            class="text-base text-white/60 hover:text-white transition-colors"
          >
            {category.title}
          </a>
        ))}
      </div>
    </details>
    <a href="/pengajian" class="text-white/70 hover:text-white font-medium transition-colors">Kajian</a>
    <a href="/masjid" class="text-white/70 hover:text-white font-medium transition-colors">Masjid</a>
    <a href="/muballigh" class="text-white/70 hover:text-white font-medium transition-colors">Muballigh</a>
    <a href="/media" class="text-white/70 hover:text-white font-medium transition-colors">Media</a>
  </nav>
  <div class="mt-auto pt-8 border-t border-white/10">
    <p class="text-white/40 text-xs">TablighMu Sidoarjo</p>
  </div>
</aside>

<script>
  (() => {
    const sidebar = document.getElementById("mobile-sidebar");
    const backdrop = document.getElementById("mobile-backdrop");
    const openBtn = document.getElementById("menu-open-btn");
    const closeBtn = document.getElementById("menu-close-btn");
    if (!sidebar || !openBtn || !closeBtn) return;

    const open = () => {
      sidebar.classList.remove("translate-x-full");
      backdrop?.classList.remove("opacity-0", "pointer-events-none");
      document.body.classList.add("overflow-hidden");
    };
    const close = () => {
      sidebar.classList.add("translate-x-full");
      backdrop?.classList.add("opacity-0", "pointer-events-none");
      document.body.classList.remove("overflow-hidden");
    };

    openBtn.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    backdrop?.addEventListener("click", close);
    sidebar.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", close);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });
  })();
</script>