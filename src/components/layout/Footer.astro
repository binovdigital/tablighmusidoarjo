---
interface Props {
  footerText?: string;
  siteTitle: string;
}
const { siteTitle } = Astro.props;
---
<footer class="border-t border-white/5 bg-[#0A0A0F]/80 backdrop-blur-xl mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-white/40 text-sm order-2 md:order-1">
        &copy; 2026 {siteTitle}. Hak cipta dilindungi.
      </p>
      <a href="/tentang" class="text-white/40 hover:text-white transition-colors text-sm order-1 md:order-2">
        Tentang Kami
      </a>
      <div class="flex items-center gap-5 order-3">
        <a
          href="https://www.instagram.com/tablighmusidoarjo/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram TablighMu Sidoarjo"
          class="text-zinc-400 hover:text-white transition-colors duration-300"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" stroke-width="1.5" />
            <circle cx="12" cy="12" r="4.5" stroke-width="1.5" />
            <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href="https://www.tiktok.com/@tablighmusidoarjo"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="TikTok TablighMu Sidoarjo"
          class="text-zinc-400 hover:text-white transition-colors duration-300"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
