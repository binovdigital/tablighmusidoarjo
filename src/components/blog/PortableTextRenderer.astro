---
import { PortableText } from "astro-portabletext";
import { urlFor } from "../../utils/image";

interface Props {
  value: any;
}
const { value } = Astro.props;
---

{value && (
  <PortableText
    value={value}
    components={{
      types: {
        image: ({ value }) => (
          <figure class="my-12">
            {value.asset && (
              <div class="rounded-[2rem] overflow-hidden">
                <img
                  src={urlFor(value.asset).width(1200).url()}
                  alt={value.alt || ""}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto"
                />
              </div>
            )}
            {value.caption && (
              <figcaption class="mt-4 text-center text-white/40 text-sm">
                {value.caption}
              </figcaption>
            )}
          </figure>
        ),
      },
      marks: {
        link: ({ children, value }) => (
          <a
            href={value.href}
            target={value.href.startsWith("http") ? "_blank" : undefined}
            rel={value.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="text-blue-400 underline underline-offset-2 hover:text-blue-300 transition-colors"
          >
            {children}
          </a>
        ),
      },
    }}
  />
)}